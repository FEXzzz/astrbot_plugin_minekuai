{
  "instance_enabled": {
    "type": "bool",
    "description": "启用实例管理",
    "default": false
  },
  "instance_api_key": {
    "type": "string",
    "description": "面板 API 密钥",
    "default": "",
    "secret": true,
    "hint": "完整的 mkc_ 开头密钥；仅用于 client-api。secret 只遮罩界面，不加密文件。请配置机器人出口 IP 白名单。"
  },
  "instance_aliases": {
    "type": "template_list",
    "description": "实例别名",
    "default": [],
    "hint": "添加别名和8位 identifier；旧版别名字典将自动迁移。",
    "templates": {
      "instance": {
        "name": "实例别名",
        "display_item": "alias",
        "items": {
          "alias": {
            "type": "string",
            "description": "别名",
            "default": ""
          },
          "identifier": {
            "type": "string",
            "description": "8位实例 identifier",
            "default": ""
          }
        }
      }
    }
  },
  "operation_permissions": {
    "type": "object",
    "description": "每项实例操作的会话权限",
    "items": {
      "list": {
        "type": "object",
        "description": "实例列表",
        "items": {
          "scope": {
            "type": "string",
            "description": "允许的会话",
            "default": "private",
            "options": [
              "disabled",
              "private",
              "group",
              "both"
            ],
            "labels": [
              "禁用",
              "仅私聊",
              "仅群聊",
              "群聊和私聊"
            ]
          },
          "allowed_groups": {
            "type": "list",
            "description": "允许的群",
            "default": [],
            "hint": "群聊模式必须显式填写群号；空列表禁止所有群。可用 平台实例ID:群号 区分多个机器人。无论会话范围，调用者都必须是 AstrBot 管理员。"
          }
        }
      },
