  "instance_requests_per_minute": {
    "type": "int",
    "description": "实例接口每分钟请求预算",
    "default": 120,
    "slider": {
      "min": 1,
      "max": 300,
      "step": 1
    }
  },
  "resource_requests_per_minute": {
    "type": "int",
    "description": "资源接口每分钟请求预算",
    "default": 120,
    "slider": {
      "min": 1,
      "max": 600,
      "step": 1
    }
  },
  "read_timeout": {
    "type": "int",
    "description": "读取超时（秒）",
    "default": 10,
    "slider": {
      "min": 1,
      "max": 60,
      "step": 1
    }
  },
  "write_timeout": {
    "type": "int",
    "description": "写操作超时（秒）",
    "default": 30,
    "slider": {
      "min": 1,
      "max": 120,
      "step": 1
    }
  },
  "confirmation_timeout": {
    "type": "int",
    "description": "操作确认有效期（秒）",
    "default": 60,
    "slider": {
      "min": 10,
      "max": 300,
      "step": 1
    }
  },
  "page_size": {
    "type": "int",
    "description": "每页资源／实例条数",
    "default": 5,
    "slider": {
      "min": 1,
      "max": 10,
      "step": 1
    }
  },
  "cards_enabled": {
    "type": "bool",
    "description": "图片卡片（失败自动回退文本）",
    "default": true
  },
  "render_timeout": {
    "type": "int",
    "description": "资源卡片渲染超时（秒）",
    "default": 20,
    "slider": {
      "min": 1,
      "max": 60,
      "step": 1
    }
  },
  "local_font_path": {
    "type": "string",
    "description": "本地中文字体路径",
    "default": "",
    "hint": "私有实例卡片仅本地绘制。Windows 自动查找微软雅黑，Linux 查找 Noto CJK 或文泉驿；未找到字体则回退文本。"
  },
  "only_translated": {
    "type": "bool",
    "description": "仅搜索已翻译资源",
    "default": false,
    "hint": "默认包含全部资源；有中文字段优先展示中文。"
  },
  "allow_prerelease": {
    "type": "bool",
    "description": "下载默认允许预发布版",
    "default": false
  },
  "cache_enabled": {
    "type": "bool",
    "description": "启用查询缓存",
    "default": true
  },
  "resource_cache_seconds": {
    "type": "object",
    "description": "资源缓存有效期（秒，0 为不缓存）",
    "items": {
      "search": {
        "type": "int",
        "description": "搜索与分面",
        "default": 300,
        "slider": {
          "min": 0,
          "max": 86400,
          "step": 1
        }
      },
      "detail": {
        "type": "int",
        "description": "资源详情",
        "default": 3600,
        "slider": {
          "min": 0,
          "max": 86400,
          "step": 1
        }
      },
      "versions": {
        "type": "int",
        "description": "版本列表",
        "default": 600,
        "slider": {
          "min": 0,
          "max": 86400,
          "step": 1
        }
      },
      "categories": {
        "type": "int",
        "description": "分类标签",
        "default": 86400,
        "slider": {
          "min": 0,
          "max": 86400,
          "step": 1
        }
      }
    }
  }
}
